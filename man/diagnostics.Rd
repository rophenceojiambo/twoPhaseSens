\name{diagnostics}
\alias{diagnostics}
\alias{diagnostics.twophase_sensitivity}
\title{Extract diagnostics from a twoPhaseSens analysis}
\usage{
diagnostics(x, ...)
}
\arguments{
  \item{x}{An object, typically of class \code{twophase_sensitivity}.}
  \item{...}{Additional arguments passed to methods.}
}
\value{
A data frame containing method status, sample sizes, and available diagnostics.
}
\description{
Extracts method-level diagnostics from a \code{twophase_sensitivity} object.
}
